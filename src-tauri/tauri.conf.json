{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotesAI",
  "version": "0.3.0",
  "identifier": "com.notesai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NotesAI",
        "width": 1400,
        "height": 900,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../vendor/yt-dlp.exe": "yt-dlp.exe",
      "../vendor/yt-dlp-LICENSE.txt": "licenses/yt-dlp-LICENSE.txt",
      "../vendor/yt-dlp-THIRD_PARTY_LICENSES.txt.txt": "licenses/yt-dlp-THIRD_PARTY_LICENSES.txt"
    }
  }
}
